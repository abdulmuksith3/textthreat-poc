{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TextThreatEvent",
  "type": "object",
  "additionalProperties": true,
  "required": ["@timestamp", "event", "text_hash", "digital_wellbeing", "source_platform"],
  "properties": {
    "@timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "module", "category"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["signal"]
        },
        "module": {
          "type": "string",
          "enum": ["textthreat"]
        },
        "category": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "text_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "digital_wellbeing": {
      "type": "object",
      "additionalProperties": true,
      "required": ["harm_types", "risk_score", "confidence", "model_version"],
      "properties": {
        "harm_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["toxic", "severe_toxic", "obscene", "threat", "insult", "identity_hate", "stress"]
          }
        },
        "risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "dp_noise_applied": {
          "type": "boolean"
        }
      }
    },
    "source_platform": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string"
    },
    "user_hash": {
      "type": "string"
    }
  }
}
