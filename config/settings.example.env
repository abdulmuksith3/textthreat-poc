# TextThreat hosted demo settings
TEXTTHREAT_TOXICITY_MODEL_ID=your-hf-username/textthreat-distilbert-jigsaw
TEXTTHREAT_STRESS_MODEL_ID=your-hf-username/textthreat-distilbert-dreaddit
TEXTTHREAT_EVENT_THRESHOLD=0.55

# Hugging Face upload settings; keep real token in local/host secrets only.
HF_TOKEN=
HF_NAMESPACE=your-hf-username

# Splunk Cloud HTTP Event Collector
SPLUNK_HEC_URL=https://<your-stack>.splunkcloud.com:8088/services/collector/event
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=textthreat
SPLUNK_SOURCETYPE=_json
SPLUNK_SOURCE=textthreat-demo
SPLUNK_VERIFY_SSL=true
SPLUNK_HEC_CHANNEL=11111111-1111-4111-8111-111111111111

# Optional Splunk management API settings for automatic index/dashboard setup.
SPLUNK_MANAGEMENT_URL=https://<your-stack>.splunkcloud.com:8089
SPLUNK_API_TOKEN=
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
SPLUNK_DASHBOARD_APP=search
SPLUNK_DASHBOARD_OWNER=nobody
SPLUNK_DASHBOARD_NAME=textthreat_digital_wellbeing_risk

# SOAR-lite SMTP alerting
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_TO_EMAIL=
ALERT_FROM_EMAIL=

# Optional OpenSearch compatibility
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
